{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug fvm",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/fvm",
            "args": ["fvm.inp"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/bin",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "为 gdb 启用美化打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}